import "../assets/fonts/CalSans-Regular.ttf";

import { Palette } from "std-widgets.slint";
import { Theme, ThemePalette } from "theme.slint";
import { Settings, Env, Status, Shell, Actions, FastFlagItem, DoctorCheck, ChangelogSection, PendingAction, ThemeOption } from "state.slint";
import { TitleBar } from "components/title-bar.slint";
import { Sidebar, NavItem } from "components/sidebar.slint";
import { StatusBar, DirtyBar, ConfirmDialog, UpdateDialog } from "components/overlays.slint";
import { HomePage } from "pages/home.slint";
import { GraphicsPage } from "pages/graphics.slint";
import { KernelPage } from "pages/kernel.slint";
import { FastFlagsPage } from "pages/fastflags.slint";
import { McpPage } from "pages/mcp.slint";
import { DoctorPage } from "pages/doctor.slint";

export { Theme, ThemePalette, ThemeOption, Settings, Env, Status, Shell, Actions, FastFlagItem, DoctorCheck, ChangelogSection, PendingAction }

export component AppWindow inherits Window {
    title: "Cutlery";
    icon: @image-url("../assets/cutlery.png");
    no-frame: true;
    background: transparent;
    min-width: 960px;
    min-height: 600px;
    preferred-width: 1250px;
    preferred-height: 700px;
    // Frameless edge resizing is handled by Slint's winit backend, which hands the drag to the
    // window manager before the press reaches any TouchArea (no stuck pointer grab).
    resize-border-width: Shell.maximized ? 0px : 6px;

    property <[NavItem]> pages: [
        { icon: @image-url("../assets/icons/tab_general.svg"), label: "General" },
        { icon: @image-url("../assets/icons/tab_graphics.svg"), label: "Graphics" },
        { icon: @image-url("../assets/icons/tab_kernel.svg"), label: "Kernel" },
        { icon: @image-url("../assets/icons/tab_fastflags.svg"), label: "FastFlags" },
        { icon: @image-url("../assets/icons/tab_mcp.svg"), label: "Universal MCP" },
        { icon: @image-url("../assets/icons/tab_doctor.svg"), label: "Doctor" },
    ];

    // std-widgets (ScrollView, Switch, Spinner) follow the theme's light/dark base.
    property <bool> dark-theme: Theme.dark;
    changed dark-theme => {
        Palette.color-scheme = self.dark-theme ? ColorScheme.dark : ColorScheme.light;
    }
    init => {
        Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light;
    }

    Rectangle {
        background: Theme.window-bg;
        border-radius: Shell.maximized ? 0px : 8px;
        border-width: Shell.maximized ? 0px : 1px;
        border-color: Theme.window-border;
        clip: true;

        if Shell.page == 0: Image {
            width: 100%;
            height: 100%;
            source: Theme.has-home-bg ? Theme.home-bg : @image-url("../assets/general_bg.png");
            image-fit: cover;
        }
        if Shell.page == 0: Rectangle {
            background: @linear-gradient(180deg, Theme.hero-top 0%, Theme.hero-top.transparentize(100%) 16%, Theme.hero-bottom.transparentize(100%) 72%, Theme.hero-bottom 100%);
        }

        VerticalLayout {
            TitleBar {
                title: root.pages[Shell.page].label;
            }

            HorizontalLayout {
                vertical-stretch: 1;

                Sidebar {
                    items: root.pages;
                    current: Shell.page;
                    selected(index) => {
                        Shell.page = index;
                        if (index == 5) {
                            Actions.run-doctor();
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    if Shell.page == 0: HomePage { }
                    if Shell.page == 1: GraphicsPage { }
                    if Shell.page == 2: KernelPage { }
                    if Shell.page == 3: FastFlagsPage { }
                    if Shell.page == 4: McpPage { }
                    if Shell.page == 5: DoctorPage { }
                }
            }

            StatusBar { }
        }

        if Settings.dirty: DirtyBar {
            width: self.preferred-width;
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 40px;
        }

        if Shell.update-open: UpdateDialog { }

        if Shell.confirm-open: ConfirmDialog { }
    }
}
