import { Switch, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings } from "../state.slint";
import { ActionButton } from "buttons.slint";

export component PillBadge inherits Rectangle {
    in property <string> text;
    in property <color> tone: Theme.ok;

    height: 24px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: root.tone.transparentize(60%);
    background: root.tone.transparentize(85%);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        Text {
            text: root.text;
            color: root.tone;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// Section card. Optional header with description, a status badge and one action.
export component Card inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <string> badge-text;
    in property <color> badge-tone: Theme.ok;
    in property <string> action-text;
    in property <bool> action-enabled: true;
    callback action();

    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-lg;

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        if root.title != "": HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.accent;
                    font-size: 14px;
                    font-weight: 700;
                }
                if root.description != "": Text {
                    text: root.description;
                    color: Theme.text-muted;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            if root.badge-text != "": VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                PillBadge {
                    text: root.badge-text;
                    tone: root.badge-tone;
                }
            }
            if root.action-text != "": VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                ActionButton {
                    text: root.action-text;
                    enabled: root.action-enabled;
                    clicked => { root.action(); }
                }
            }
        }

        @children
    }
}

// A labelled setting backed by a switch. Every toggle counts as a settings edit.
export component SettingToggle inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked <=> sw.checked;

    spacing: 16px;

    VerticalLayout {
        alignment: center;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.description;
            color: Theme.text-muted;
            font-size: 12px;
            overflow: elide;
        }
    }

    sw := Switch {
        accessible-label: root.title;
        toggled => { Settings.changed(); }
    }
}

// Read-only "label: value" box on a sunken background.
export component InfoField inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> value-color: Theme.text;

    min-height: 34px;
    background: Theme.surface-sunken;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-sm;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

// Scrollable settings page with a centered, width-capped column of cards.
export component Page inherits ScrollView {
    out property <length> column-width: min(self.visible-width - 48px, 920px);

    VerticalLayout {
        padding-top: 16px;
        padding-bottom: 96px;
        padding-left: max(24px, (root.visible-width - root.column-width) / 2);
        padding-right: self.padding-left;
        spacing: 12px;
        alignment: start;
        @children
    }
}
