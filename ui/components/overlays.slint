import { Spinner } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Settings, Status, Env, Shell, Actions, PendingAction } from "../state.slint";
import { ActionButton } from "buttons.slint";

export component StatusBar inherits Rectangle {
    height: 28px;
    background: Theme.status-glass;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;

        if Status.busy: VerticalLayout {
            alignment: center;
            Spinner {
                width: 14px;
                height: 14px;
                indeterminate: true;
            }
        }
        Text {
            text: Status.text;
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Text {
            text: "Studio: " + Env.studio-version;
            color: Env.studio-installed ? Theme.text-muted : Theme.warn;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
}

// Floating bar shown while the edited settings differ from the saved config.
export component DirtyBar inherits Rectangle {
    height: 48px;
    border-radius: self.height / 2;
    background: Theme.overlay-bg;
    border-color: Theme.accent;
    border-width: 1px;
    drop-shadow-blur: 16px;
    drop-shadow-color: Theme.shadow;

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 8px;
        spacing: 10px;
        alignment: center;

        Text {
            text: "Unapplied changes";
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: "Revert";
                clicked => { Settings.revert(); }
            }
        }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: "Apply";
                primary: true;
                clicked => { Settings.apply(); }
            }
        }
    }
}

export component ConfirmDialog inherits Rectangle {
    background: Theme.scrim;

    // Swallow clicks on the backdrop.
    TouchArea { }

    Rectangle {
        width: 460px;
        height: box.preferred-height;
        background: Theme.overlay-bg;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;

        box := VerticalLayout {
            padding: 20px;
            spacing: 18px;

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: Shell.pending-action == PendingAction.close ? "Close with unapplied changes?"
                        : Shell.pending-action == PendingAction.update ? "Update with unapplied changes?"
                        : "Launch with unapplied changes?";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: "Some settings were changed but not applied. Apply them before continuing, or discard them.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ActionButton {
                    text: "Cancel";
                    clicked => { Shell.confirm-open = false; }
                }
                ActionButton {
                    text: "Discard & Continue";
                    clicked => {
                        Shell.confirm-open = false;
                        Actions.confirm-proceed(Shell.pending-action, false);
                    }
                }
                ActionButton {
                    text: "Apply & Continue";
                    primary: true;
                    clicked => {
                        Shell.confirm-open = false;
                        Actions.confirm-proceed(Shell.pending-action, true);
                    }
                }
            }
        }
    }
}

// Offered by the Update button when a newer Cutlery release exists.
export component UpdateDialog inherits Rectangle {
    background: Theme.scrim;

    TouchArea { }

    Rectangle {
        width: 440px;
        height: box.preferred-height;
        background: Theme.overlay-bg;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: Theme.radius-lg;
        drop-shadow-blur: 24px;
        drop-shadow-color: Theme.shadow;

        box := VerticalLayout {
            padding: 20px;
            spacing: 18px;

            VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Cutlery update available";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 700;
                }
                Text {
                    text: Shell.update-from + "  →  " + Shell.update-to;
                    color: Theme.accent;
                    font-family: Theme.display-font;
                    font-size: 20px;
                }
                Text {
                    text: "The new release is downloaded from GitHub, verified (SHA-256) and installed. Cutlery restarts afterwards; your Wine prefix and settings are kept.";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                ActionButton {
                    text: "Not now";
                    clicked => {
                        Shell.update-open = false;
                        Actions.decline-update();
                    }
                }
                ActionButton {
                    text: "Update & Restart";
                    primary: true;
                    clicked => {
                        Shell.update-open = false;
                        Actions.accept-update();
                    }
                }
            }
        }
    }
}
