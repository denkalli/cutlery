import { Theme } from "../theme.slint";
import { Settings, Env, Actions } from "../state.slint";
import { Card, Page, SettingToggle } from "../components/card.slint";
import { ActionButton, ColorChip, SegmentButton, ThemeCard } from "../components/buttons.slint";

// Theme tiles laid out in rows that wrap to the available width.
component ThemeGrid inherits Rectangle {
    property <length> tile-w: 156px;
    property <length> tile-h: 112px;
    property <length> gap: 10px;
    property <int> columns: max(1, floor((self.width + gap) / (tile-w + gap)));

    height: ceil(Env.themes.length / columns) * (tile-h + gap) - gap;

    for option[i] in Env.themes: ThemeCard {
        x: mod(i, root.columns) * (root.tile-w + root.gap);
        y: floor(i / root.columns) * (root.tile-h + root.gap);
        name: option.name;
        author: option.author;
        bg: option.bg;
        surface: option.surface;
        text: option.text;
        accent: option.has-accent ? option.accent : Theme.accent-for(Settings.accent-name);
        selected: Settings.theme-name == option.id;
        clicked => {
            Settings.theme-name = option.id;
            Settings.changed();
        }
    }
}

export component GraphicsPage inherits Page {
    Card {
        title: "Appearance";
        description: "Theme, accent color and launcher behavior.";
        action-text: "Open Themes Folder";
        action => { Actions.open-themes-folder(); }

        ThemeGrid { }

        if Env.theme-errors != "": Text {
            text: "Some themes could not be loaded:\n" + Env.theme-errors;
            color: Theme.warn;
            font-size: 12px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            for accent in Theme.accents: ColorChip {
                label: accent.label;
                chip-color: accent.color;
                selected: !Theme.fixed-accent && Settings.accent-name == accent.name;
                clicked => {
                    Settings.accent-name = accent.name;
                    Settings.changed();
                }
            }
        }
        if Theme.fixed-accent: Text {
            text: "This theme sets its own accent color; the accent picked here applies to the other themes.";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 10px;
            ActionButton {
                text: "Reload Themes";
                clicked => { Actions.reload-themes(); }
            }
            Text {
                text: "Custom themes (.toml): " + Env.themes-dir;
                color: Theme.text-faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
        SettingToggle {
            title: "Apply theme to Roblox Studio (experimental)";
            description: "Recolors Studio's panels, menus and Script Editor; the ribbon, Explorer and Toolbox keep Studio's colors.";
            checked <=> Settings.studio-theme;
        }
        SettingToggle {
            title: "Open Cutlery Settings on launch";
            description: "Opening Cutlery from the app drawer shows this dashboard instead of launching Studio directly.";
            checked <=> Settings.always-open-ui;
        }
    }

    Card {
        title: "DXVK Vulkan Renderer & Swapchain";
        SettingToggle {
            title: "DirectComposition Dummy Swapchain";
            description: "Emulates the composition swapchain so QtitanDocking multi-window guide markers render safely.";
            checked <=> Settings.dummy-composition;
        }
        SettingToggle {
            title: "DXVK Asynchronous Shader Pipelines";
            description: "Compiles Vulkan pipelines in background threads to avoid viewport stutter.";
            checked <=> Settings.dxvk-async;
        }
    }

    Card {
        title: "Display & Framerate";
        description: "Roblox TaskScheduler FPS cap (DFIntTaskSchedulerTargetFps).";

        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for fps in [60, 120, 144, 240, 0]: SegmentButton {
                text: fps == 0 ? "Unlimited" : fps + " FPS";
                active: Settings.target-fps == fps;
                clicked => {
                    Settings.target-fps = fps;
                    Settings.changed();
                }
            }
        }
    }
}
