import { Theme } from "../theme.slint";
import { Settings, Env, Actions } from "../state.slint";
import { Card, Page, SettingToggle, InfoField } from "../components/card.slint";
import { ActionButton } from "../components/buttons.slint";
import { LineEdit } from "std-widgets.slint";

export component McpPage inherits Page {
    Card {
        title: "Google Antigravity Integration";
        description: "Links Roblox Studio MCP tools to the Antigravity plugin at ~/.gemini/config/plugins/roblox-studio.";
        badge-text: Env.antigravity-linked ? "Plugin Linked" : "Needs Linking";
        badge-tone: Env.antigravity-linked ? Theme.ok : Theme.warn;

        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            ActionButton {
                text: "Link Antigravity Plugin";
                primary: true;
                clicked => { Actions.link-antigravity(); }
            }
            ActionButton {
                text: "Open Plugin Directory";
                clicked => { Actions.open-antigravity-folder(); }
            }
        }
        InfoField {
            label: "Plugin command:";
            value: Env.antigravity-path;
        }
    }

    Card {
        title: "AI Agent Bridge (Model Context Protocol)";
        SettingToggle {
            title: "Universal MCP Server Bridge";
            description: "stdio JSON-RPC bridge for Claude Desktop, Cursor, Codex and Antigravity.";
            checked <=> Settings.mcp-enabled;
        }
        SettingToggle {
            title: "Pre-Initialization Shield";
            description: "Answers non-standard agent probes locally (-32601) to protect the StudioMCP.exe handshake.";
            checked <=> Settings.preinit-shield;
        }
    }

    Card {
        title: "Other AI Clients";
        action-text: "Test MCP Bridge";
        action => { Actions.test-mcp(); }

        HorizontalLayout {
            alignment: start;
            ActionButton {
                text: "Configure Claude Desktop";
                clicked => { Actions.configure-claude(); }
            }
        }
        InfoField {
            label: "Bridge status:";
            value: Env.mcp-test-status;
            value-color: Theme.ok;
        }
    }

    Card {
        title: "Discord Rich Presence";
        description: "Shows the place you are editing or testing on your Discord profile while Studio runs.";
        badge-text: Env.discord-available ? "Discord detected" : "Discord not running";
        badge-tone: Env.discord-available ? Theme.ok : Theme.warn;

        SettingToggle {
            title: "Enable Rich Presence";
            description: "Follows Studio's log and updates Discord over its local IPC socket.";
            checked <=> Settings.discord-enabled;
        }
        SettingToggle {
            title: "Privacy Mode";
            description: "Shows only \"Editing a place\", without the experience name or Roblox link.";
            checked <=> Settings.discord-privacy;
        }
        SettingToggle {
            title: "Show Elapsed Time";
            description: "Time since the place was opened, or since the playtest started.";
            checked <=> Settings.discord-elapsed;
        }
        SettingToggle {
            title: "Show Buttons";
            description: "\"View on Roblox\" (when the place is shown) and \"Get Cutlery\".";
            checked <=> Settings.discord-buttons;
        }
        LineEdit {
            placeholder-text: "Custom Discord Application ID (optional)";
            text <=> Settings.discord-app-id;
            edited => { Settings.changed(); }
        }
    }
}
