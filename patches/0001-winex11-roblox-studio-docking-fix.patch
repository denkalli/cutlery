 }
 
 /***********************************************************************
@@ -3623,6 +3634,21 @@ LRESULT X11DRV_SysCommand( HWND hwnd, WPARAM wparam, LPARAM lparam, const POINT
     switch (wparam & 0xfff0)
     {
     case SC_MOVE:
+        /* Under rootless X11, _NET_WM_MOVERESIZE causes the window manager to grab the
+         * pointer and swallow all intermediate motion/moving events.
+         * As a result, Roblox Studio (QtitanDocking) never receives WM_MOVING notifications,
+         * preventing docking targets and guide markers from showing up, making panels un-dockable.
+         * By returning failure (-1), win32u executes its internal sys_command_size_move loop,
+         * which captures the cursor in Win32, sends continuous WM_MOVING messages, and allows
+         * native docking detection to work smoothly. */
+        if ((NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_TOOLWINDOW) ||
+            (process_name && (strstr( process_name, "Roblox" ) || strstr( process_name, "roblox" ))) ||
+            getenv( "WINE_STUDIO_DOCKING_FIX" ))
+        {
+            TRACE( "Bypassing _NET_WM_MOVERESIZE for window %p to enable Win32 sys_command_size_move\n", hwnd );
+            goto failed;
+        }
+
         if (!hittest) dir = _NET_WM_MOVERESIZE_MOVE_KEYBOARD;
         else dir = _NET_WM_MOVERESIZE_MOVE;
         break;
